<!doctype html>
<html lang="en">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta http-equiv="refresh" content="5">
<title>{{ title }}</title>
<style>
:root{font:16px/1.6 system-ui,sans-serif;color:#202627;background:#fcfcfa;color-scheme:light}
body{margin:0;min-height:100vh;display:grid;place-items:center}
main{max-width:30rem;padding:2rem}h1{font-size:1.5rem;line-height:1.3}
</style>
<main role="status">
<h1>{{ title }}</h1>
<p>{{ message }} This page checks again every five seconds.</p>
</main>
</html>
