server_names_hash_bucket_size 256;

geo $pilot_from_cloudflare {
    default 0;
    {% for network in cloudflare_networks %}
    {{ network }} 1;
    {% endfor %}
}

map $pilot_from_cloudflare $pilot_client_addr {
    1       $http_cf_connecting_ip;
    default $remote_addr;
}

log_format pilot_access '$pilot_client_addr [$time_local] "$request_method $uri" $status "$host" $request_time';

server {
    listen {{ http_port }} default_server;
    listen [::]:{{ http_port }} default_server;
    server_name _;

    {% for code in error_codes %}
    error_page {{ code }} /_errors/{{ code }}.html;
    {% endfor %}
    location ^~ /_errors/ {
        internal;
        alias {{ error_dir }}/;
    }

    location / {
        return 404;
    }
}

server {
    listen {{ https_port }} ssl http2 default_server;
    listen [::]:{{ https_port }} ssl http2 default_server;
    server_name _;

    ssl_reject_handshake on;
    {% if cloudflare_networks %}
    ssl_prefer_server_ciphers off;
    {% endif %}
}
