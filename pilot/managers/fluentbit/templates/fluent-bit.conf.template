[SERVICE]
    # Datum allows 12 requests a minute per token. Every line reaches the
    # output through one emitter (see rewrite_tag below), so a flush sends one
    # chunk: 2 a minute, each sent at most 1 + Retry_Limit (3) times, is at
    # most 8 a minute even while Datum refuses every one.
    Flush                     30
    scheduler.base            10
    scheduler.cap             60
    Log_Level                 info
    Parsers_File              {{ conf_dir }}/parsers.conf

    storage.path              {{ conf_dir }}/state
    storage.sync              normal
    storage.checksum          off
    storage.backlog.mem_limit 50M


# ============================================================
# Python / Frappe logs
#
#   {{ cli_root }}/benches/<bench>/logs/*.log
#
# Broad *.log pattern; formats with their own parser or that we
# skip are excluded below. See docs/architecture.md for why the
# site log mirror is not tailed here.
# ============================================================

[INPUT]
    Name              tail
    Tag               pilot.python

    Path              {{ cli_root }}/benches/*/logs/*.log

    Exclude_Path      {{ cli_root }}/benches/*/logs/nginx-access.log,{{ cli_root }}/benches/*/logs/nginx-error.log,{{ cli_root }}/benches/*/logs/*.json.log,{{ cli_root }}/benches/*/logs/redis_*.log,{{ cli_root }}/benches/*/logs/worker_pool*.log,{{ cli_root }}/benches/*/logs/*.error.log,{{ cli_root }}/benches/*/logs/socketio.log,{{ cli_root }}/benches/*/logs/web.log,{{ cli_root }}/benches/*/logs/cssutils.log,{{ cli_root }}/benches/*/logs/render-template.log

    Path_Key          filename

    Multiline.Parser  pilot_python_multiline

    DB                {{ conf_dir }}/tail-python.db

    Mem_Buf_Limit     10MB
    Skip_Long_Lines   On
    Read_from_Head    Off

    storage.type      filesystem


# ============================================================
# JSON Lines
#
# Examples:
#   uptime.json.log
#   monitor.json.log
# ============================================================

[INPUT]
    Name              tail
    Tag               pilot.json

    Path              {{ cli_root }}/benches/*/logs/*.json.log,{{ cli_root }}/benches/*/sites/*/logs/*.json.log

    Path_Key          filename

    Parser            pilot_json

    DB                {{ conf_dir }}/tail-json.db

    Mem_Buf_Limit     10MB
    Skip_Long_Lines   On
    Read_from_Head    Off

    storage.type      filesystem


# ============================================================
# Nginx access
# ============================================================

[INPUT]
    Name              tail
    Tag               pilot.nginx.access

    Path              {{ cli_root }}/benches/*/logs/nginx-access.log

    Path_Key          filename

    Parser            pilot_nginx_access

    DB                {{ conf_dir }}/tail-nginx-access.db

    Mem_Buf_Limit     10MB
    Skip_Long_Lines   On
    Read_from_Head    Off

    storage.type      filesystem


# ============================================================
# Nginx error
# ============================================================

[INPUT]
    Name              tail
    Tag               pilot.nginx.error

    Path              {{ cli_root }}/benches/*/logs/nginx-error.log

    Path_Key          filename

    Parser            pilot_nginx_error

    DB                {{ conf_dir }}/tail-nginx-error.db

    Mem_Buf_Limit     10MB
    Skip_Long_Lines   On
    Read_from_Head    Off

    storage.type      filesystem


# ============================================================
# Redis
#
# Examples:
#   redis_cache.log
#   redis_queue.log
# ============================================================

[INPUT]
    Name              tail
    Tag               pilot.redis

    Path              {{ cli_root }}/benches/*/logs/redis_*.log,{{ cli_root }}/benches/*/sites/*/logs/redis_*.log

    Exclude_Path      {{ cli_root }}/benches/*/logs/redis_*.log.error.log,{{ cli_root }}/benches/*/sites/*/logs/redis_*.log.error.log

    Path_Key          filename

    Parser            pilot_redis

    DB                {{ conf_dir }}/tail-redis.db

    Mem_Buf_Limit     10MB
    Skip_Long_Lines   On
    Read_from_Head    Off

    storage.type      filesystem


# ============================================================
# Worker pool
# ============================================================

[INPUT]
    Name              tail
    Tag               pilot.worker_pool

    Path              {{ cli_root }}/benches/*/logs/worker_pool*.log,{{ cli_root }}/benches/*/sites/*/logs/worker_pool.log

    Exclude_Path      {{ cli_root }}/benches/*/logs/*.error.log

    Path_Key          filename

    Parser            pilot_worker_pool

    DB                {{ conf_dir }}/tail-worker-pool.db

    Mem_Buf_Limit     10MB
    Skip_Long_Lines   On
    Read_from_Head    Off

    storage.type      filesystem


# ============================================================
# Parse the completed Python/Frappe multiline record
# ============================================================

[FILTER]
    Name          parser
    Match         pilot.python

    Key_Name      log
    Parser        pilot_python

    Preserve_Key  On
    Reserve_Data  On


# ============================================================
# Normalize every supported format into Datum's schema
# ============================================================

[FILTER]
    Name            lua
    Match           pilot.*
    Script          {{ conf_dir }}/pilot.lua
    Call            normalize
    Protected_Mode  On


# ============================================================
# Funnel every input into one stream
#
# Each input keeps its own chunks, and the output sends each
# chunk as its own request. Re-emitting every normalized line
# under one tag gives the output a single chunk stream.
# ============================================================

[FILTER]
    Name                  rewrite_tag
    Match                 pilot.*
    Rule                  $product ^pilot$ datum.logs false
    Emitter_Name          datum
    Emitter_Storage.type  filesystem
    Emitter_Mem_Buf_Limit 10M


# ============================================================
# Datum
# ============================================================

[OUTPUT]
    Name          http
    Match         datum.logs

    Host          {{ host }}
    Port          {{ port }}
    URI           {{ uri }}
    {% if tls %}
    tls           On
    tls.verify    On
    {% endif %}

    Header        Authorization Bearer ${DATUM_LOG_TOKEN}

    # One JSON array of Datum log lines per chunk.
    Format        json
    json_date_key false

    Workers       1
    # A refused chunk is dropped after a few tries rather than retried
    # forever, and the backlog on disk is bounded.
    Retry_Limit   3
    storage.total_limit_size 100M
