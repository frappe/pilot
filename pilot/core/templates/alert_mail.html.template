<table cellpadding="0" cellspacing="0" role="presentation" width="100%" style="background:#f4f5f6">
<tr><td align="center" valign="top">
<table cellpadding="0" cellspacing="0" role="presentation" width="600" style="width:600px">
<tr><td style="padding:40px 32px 24px;text-align:center">
{% if logo_cid %}<img src="cid:{{ logo_cid }}" width="40" height="40" alt="Pilot" style="display:block;margin:0 auto 8px">{% endif %}
<span style="font-weight:bold;font-size:20px;color:#171717">Pilot</span>
</td></tr>
<tr><td style="padding:32px;background:#ffffff;border-radius:8px;font-size:14px;line-height:1.6;color:#171717">
<h2 style="margin:0 0 16px;font-size:16px;font-weight:bold">{{ summary }}</h2>
{% if rows %}
<table cellpadding="0" cellspacing="0" role="presentation" style="width:100%;border-collapse:collapse;margin:16px 0">
<tr>
{% for heading in headings %}
<th style="text-align:left;padding:8px 12px;border-bottom:2px solid #e2e2e2;font-size:12px;color:#8d8d8d;text-transform:uppercase">{{ heading }}</th>
{% endfor %}
</tr>
{% for row in rows %}
<tr>
{% for cell in row %}
<td style="padding:8px 12px;border-bottom:1px solid #f0f0f0">{{ cell }}</td>
{% endfor %}
</tr>
{% endfor %}
</table>
{% endif %}
<p style="margin:16px 0 0;color:#8d8d8d;font-size:13px">Bench: {{ bench }} &middot; {{ time }}</p>
<div style="height:1px;background:#e2e2e2;margin:24px 0"></div>
<p style="margin:0">Thanks,<br>Team Pilot</p>
</td></tr>
<tr><td style="padding:24px 32px;text-align:center;color:#8d8d8d;font-size:12px">
This is an automated alert from Pilot. Please do not reply to this email.
</td></tr>
</table>
</td></tr>
</table>
